<!-- Switch shader → SPIR-V translation tool (built with dm/tools/native_tools.sh). It references the Ryujinx shader translator source kept in the repository (dm/third_party/ryujinx); -p:RyuSrc=<dir> points it at another copy. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AnyCPU under any -r: a build for a runtime ID otherwise ties the dll to that architecture, and the universal launcher's x86_64 half cannot load an arm64 dll (GitHub issue #803) -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- No build-machine paths in the binaries (a home path once reached the public repository through them): source paths map to /_/, and no SourceLink
         (it would embed the git remote and commit) -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../'))=/_/</PathMap>
    <Deterministic>true</Deterministic>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
  <!-- Stamps the source digest passed as -p:XlateSourceSha=$(python3 dm/gfx/tools/dmsh_chain.py - -xlate-source-sha) (dmsh_chain.xlate_source_sha() over Program.cs, dmsh_xlate.csproj and
       dm/third_party/ryujinx), which the source-sha argument prints and tool_lock.py checks: without it the translator prints "unknown" and the shader tools refuse it.
       dmsh_xlate_android.csproj stamps the same way (its build.sh passes the digest). -->
  <PropertyGroup>
    <XlateSourceSha Condition="'$(XlateSourceSha)' == ''">unknown</XlateSourceSha>
  </PropertyGroup>
  <Target Name="WriteXlateSourceSha" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_XlateSourceShaFile>$(IntermediateOutputPath)XlateSourceSha.g.cs</_XlateSourceShaFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_XlateSourceShaFile)" Lines="static partial class SwshXlate { const string SourceSha = &quot;$(XlateSourceSha)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_XlateSourceShaFile)" />
    </ItemGroup>
  </Target>
</Project>
