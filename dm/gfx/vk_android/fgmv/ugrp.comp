void phase7(int li) {   // (L_REPAR) phase 6's re-pick of one listed group, a workgroup each (dispatched indirectly: C_IND + 28)
    if (skip()) return;
    for (int i = li; i < NT; i += 256) lab[i] = u[O_LAB + i];
    sync();
    repick(li, gl_WorkGroupID.x);
}
void phase8(int li) {   // (L_REPAR) phase 6's accept after the re-picks
    if (skip()) return;
    for (int i = li; i < NT; i += 256) lab[i] = u[O_LAB + i];
    sync();
    accept4(li);
}
void phase5(int li) {   // (folded into phase 1's last pass; kept for a separate dispatch)
    if (u[O_CNT + C_CAP] != 0u) return;
    for (int i = li; i < NT; i += 256) lab[i] = u[O_LAB + i];
    moving(li);
}
void verdict(uint wg, uint v) { atomicAnd(u[O_CNT + C_FL], ~(3u << (2u * wg))); atomicOr(u[O_CNT + C_FL], v << (2u * wg)); }   // (only this workgroup's 2 bits)
