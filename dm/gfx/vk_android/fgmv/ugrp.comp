    uint npl = smn;
    if ((pc.lev & L_REPAR) != 0) {   // (L_REPAR: a workgroup per listed group, phase 7, then the accept, phase 8)
        if (li == 0) { int b = O_CNT + C_IND + 28; u[b] = npl; u[b + 1] = 1u; u[b + 2] = 1u; }
