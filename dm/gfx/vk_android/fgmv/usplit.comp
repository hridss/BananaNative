}
void main() {
    int li = int(gl_LocalInvocationIndex);
    if (pc.phase == 0) phase0(li); else if (pc.phase == 1) phase1(li); else if (pc.phase == 2) phase2(li); else if (pc.phase == 3) phase3(li); else phase4(li);
}
