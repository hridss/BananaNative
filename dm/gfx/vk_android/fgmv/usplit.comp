}
void phase4(int li) {   // (UISPASS) the next pass's sub-groups: the tiles this pass's kept sub-groups did not keep, 8-connected, in the order of their first tile
    if (u[O_CNT + C_SOVER] != 0u || u[O_CNT + C_SNOA2] != 0u) return;
