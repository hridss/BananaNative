#version 450
// the splat's field (render size): each claimed texel takes the winner,
// a hole takes, up to <iters> Jacobi steps, the farthest claimed 3x3 neighbour (the smallest depth, first in row order; texels off the picture are never filled and
// never chosen), what is still a hole then its own texel. A 16x16 tile with no hole in its 17x17 core (the tile and its right / bottom neighbours) never changes: it
// loads the core only and skips the steps; otherwise the apron (6 left / top, 7 right / bottom) is loaded, step k runs only on the core grown by iters - k (all the core
// depends on), and a step that changes nothing ends the steps (no later one could). The winner's index is carried, its vector read once at the store.
// Out (flags 1): pick = per render texel (x0, y0) the nearest-depth of the 2x2 (x0..x0+1, y0..y0+1) clamped to the picture, in row order, strictly greater replaces
// (what the resolve picks: one read instead of four); (flags 2): field = the texel's own winner. Both: x = the vector (raw, packHalf2x16), y = the depth's bits.
// (flags 4, unused by the host): a texel that was a hole after the splat keeps taking, in every step, a strictly farther (smaller depth) 3x3 neighbour (first in row order)
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D key;
layout(set = 0, binding = 1, r32f) uniform readonly image2D od;
layout(set = 0, binding = 2, rg16f) uniform readonly image2D ov;
layout(set = 0, binding = 3, rg32ui) uniform writeonly uimage2D pick;
layout(set = 0, binding = 4, rg32ui) uniform writeonly uimage2D field;
layout(push_constant) uniform PC { int iw, ih, iters; uint flags, imask; } pc;   // imask: the splat key's index bits
const int LO = 6, T = 29, N = T * T, C0 = 6, C1 = 22, NC = 17;
const uint HOLE = 0xFFFFFFFFu, OUT = 0xFFFFFFFEu;
const float INF = 1e30;
shared uint ss[2][N];
shared float sz[2][N];
shared uint anyHole;
shared bool h0[N];
shared uint chg[3];
ivec2 o;
bool inimg(ivec2 p) { return p.x >= 0 && p.y >= 0 && p.x < pc.iw && p.y < pc.ih; }
ivec2 sxy(uint s) { return ivec2(int(s % uint(pc.iw)), int(s / uint(pc.iw))); }
void ld(int w, bool core) {
    ivec2 p = o + ivec2(w % T, w / T); uint s = OUT; float z = INF;
    if (inimg(p)) {
        uint k = imageLoad(key, p).r;
        if (k != 0u) { s = k & pc.imask; z = imageLoad(od, sxy(s)).r; }
        else { s = HOLE; if (core) atomicOr(anyHole, 1u); }
    }
    ss[0][w] = s; sz[0][w] = z; h0[w] = s == HOLE;
}
bool incore(int w) { int x = w % T, y = w / T; return x >= C0 && x <= C1 && y >= C0 && y <= C1; }
void main() {
    o = ivec2(gl_WorkGroupID.xy) * 16 - LO; int li = int(gl_LocalInvocationIndex);
    if (li == 0) { anyHole = 0u; chg[0] = 0u; chg[1] = 0u; chg[2] = 0u; }
    barrier();
    for (int i = li; i < NC * NC; i += 256) ld((C0 + i / NC) * T + C0 + i % NC, true);
    barrier();
    int a = 0; bool lite = (pc.flags & 4u) != 0u;
    if (anyHole != 0u && pc.iters > 0) {   // (uniform)
        for (int i = li; i < N; i += 256) if (!incore(i)) ld(i, false);
        barrier();
        for (int k = 1; k <= pc.iters; k++) {
            int g = pc.iters - k, lo = C0 - g, n = NC + 2 * g;
            if (li == 0) chg[(k + 1) % 3] = 0u;   // step k+1's flag: last read after step k-2's barrier, step k-1's barrier since
            for (int i = li; i < n * n; i += 256) {
                int w = (lo + i / n) * T + lo + i % n;
                uint s = ss[a][w]; float z = sz[a][w];
                if (lite ? h0[w] : s == HOLE) {
                    float bz = INF; uint bs = HOLE;
                    for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) { int q = w + dy * T + dx; float nz = sz[a][q]; if (nz < bz) { bz = nz; bs = ss[a][q]; } }
                    if (bz < z) { s = bs; z = bz; chg[k % 3] = 1u; }
                }
                ss[1 - a][w] = s; sz[1 - a][w] = z;
            }
            barrier(); a = 1 - a;
            if (chg[k % 3] == 0u) break;   // (uniform: read after the barrier)
        }
    }
    for (int i = li; i < NC * NC; i += 256) {
        int w = (C0 + i / NC) * T + C0 + i % NC;
        if (ss[a][w] == HOLE) { ivec2 p = o + ivec2(w % T, w / T); ss[a][w] = uint(p.y * pc.iw + p.x); sz[a][w] = imageLoad(od, p).r; }
    }
    barrier();
    ivec2 l = ivec2(gl_LocalInvocationID.xy), p = o + LO + l;
    if (!inimg(p)) return;
    int w = (C0 + l.y) * T + C0 + l.x;
    uint s = ss[a][w]; float z = sz[a][w];
    if ((pc.flags & 2u) != 0u) imageStore(field, p, uvec4(packHalf2x16(imageLoad(ov, sxy(s)).xy), floatBitsToUint(z), 0u, 0u));
    if ((pc.flags & 1u) != 0u) {
        int dx1 = p.x + 1 < pc.iw ? 1 : 0, dy1 = p.y + 1 < pc.ih ? T : 0;
        int q1 = w + dx1, q2 = w + dy1, q3 = w + dy1 + dx1;
        if (sz[a][q1] > z) { z = sz[a][q1]; s = ss[a][q1]; }
        if (sz[a][q2] > z) { z = sz[a][q2]; s = ss[a][q2]; }
        if (sz[a][q3] > z) { z = sz[a][q3]; s = ss[a][q3]; }
        imageStore(pick, p, uvec4(packHalf2x16(imageLoad(ov, sxy(s)).xy), floatBitsToUint(z), 0u, 0u));
    }
}
