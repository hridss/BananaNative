#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
// One workgroup: CUT = (res > t_res and median tile corr < t_corr) or mvmean > t_mv or (dlss rule on and DLSS ran in one of A, C only)
shared float cr[256]; shared uint ok[256]; shared float sm[4][256]; shared float med2[2];
void main() {
    uint i = gl_LocalInvocationIndex;
    float n = 0.0, r = 0.0, mv = 0.0, nm = 0.0, corr = 1.0; uint valid = 0u;
    if (i < NTX * NTY) {
        uint b = i * 9u; n = tl[b]; r = tl[b + 1u]; mv = tl[b + 7u]; nm = tl[b + 8u];
        valid = n >= 0.5 * float(TS * TS) ? 1u : 0u;
        if (valid != 0u) {
            float mc = tl[b + 2u] / n, ma = tl[b + 3u] / n;
            float vc = tl[b + 4u] / n - mc * mc, va = tl[b + 5u] / n - ma * ma, cv = tl[b + 6u] / n - mc * ma;
            if (vc <= 4.0 || va <= 4.0) corr = abs(mc - ma) < 12.0 ? 1.0 : 0.0; else corr = cv / sqrt(vc * va);
        }
    }
    cr[i] = corr; ok[i] = valid; sm[0][i] = n; sm[1][i] = r; sm[2][i] = mv; sm[3][i] = nm;
    if (i < 2u) med2[i] = 1.0;
    barrier();
    uint nv = 0u; for (uint j = 0u; j < NTX * NTY; j++) nv += ok[j];
    if (valid != 0u) {   // rank among valid tiles (ties by index); median = mean of ranks (nv-1)/2 and nv/2
        uint rk = 0u; for (uint j = 0u; j < NTX * NTY; j++) if (ok[j] != 0u && (cr[j] < corr || (cr[j] == corr && j < i))) rk++;
        if (rk == (nv - 1u) / 2u) med2[0] = corr;
        if (rk == nv / 2u) med2[1] = corr;
    }
    for (uint s = 128u; s > 0u; s >>= 1) { barrier(); if (i < s) for (int k = 0; k < 4; k++) sm[k][i] += sm[k][i + s]; }
    barrier();
    if (i == 0u) {
        float res = sm[0][0] > 0.0 ? sm[1][0] / sm[0][0] : 0.0, mvm = sm[3][0] > 0.0 ? sm[2][0] / sm[3][0] : 0.0;
        float med = nv > 0u ? 0.5 * (med2[0] + med2[1]) : 1.0;
        bool cut = (res > pc.t_res && med < pc.t_corr) || mvm > pc.t_mv || ((pc.flags & 18u) == 18u);
        rs[0] = cut ? 1.0 : 0.0; rs[1] = res; rs[2] = med; rs[3] = mvm; rs[4] = float(nv); rs[5] = (pc.flags & 2u) != 0u ? 1.0 : 0.0;
    }
}
